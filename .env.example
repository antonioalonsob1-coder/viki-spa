# Número de WhatsApp de negocio en formato E.164 sin '+' (ej: 56912345678)
VITE_WHATSAPP_NUMBER="56912345678"

# El backend usa Cloudflare D1 (base de datos) y R2 (fotos de galería), configurados
# como bindings en wrangler.toml — no son variables de entorno.
#
# El único secreto real es SESSION_SECRET (clave para firmar la cookie de sesión del
# panel admin), que se define así (no va en este archivo ni en el repo):
#   npx wrangler pages secret put SESSION_SECRET --project-name=viki-spa
