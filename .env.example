# Cadena de conexión de Neon Postgres (pooled) — usada por Prisma en runtime
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Cadena de conexión directa (sin pooler) — usada por Prisma Migrate
DIRECT_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Número de WhatsApp de negocio en formato E.164 sin '+' (ej: 56912345678)
VITE_WHATSAPP_NUMBER="56912345678"
