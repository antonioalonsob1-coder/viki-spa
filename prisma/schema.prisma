// Esquema Prisma para Viki SpA
// Base de datos: PostgreSQL servido por Neon (https://neon.tech)
// Uso: define DATABASE_URL en .env y ejecuta `npx prisma migrate dev`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CategoriaProyecto {
  HOGAR
  INSTITUCIONAL
}

enum CategoriaGaleria {
  HOGAR_CORTINAJE
  LICENCIATURAS_COLEGIOS
}

enum TipoServicioCotizacion {
  HOGAR
  COLEGIO_LICENCIATURA
}

enum EstadoCotizacion {
  NUEVA
  CONTACTADO
  EN_NEGOCIACION
  CERRADA
  DESCARTADA
}

model Proyecto {
  id          String            @id @default(cuid())
  titulo      String
  descripcion String?
  categoria   CategoriaProyecto
  cliente     String?
  destacado   Boolean           @default(false)
  fechaEntrega DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  fotos GaleriaFoto[]

  @@map("proyectos")
}

model GaleriaFoto {
  id         String           @id @default(cuid())
  categoria  CategoriaGaleria
  titulo     String
  url        String
  proyecto   Proyecto?        @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  proyectoId String?
  createdAt  DateTime         @default(now())

  @@index([categoria])
  @@map("galeria_fotos")
}

model Cotizacion {
  id                String                 @id @default(cuid())
  nombre            String
  contacto          String
  tipoServicio      TipoServicioCotizacion
  espacioOProducto  String?
  colegioONivel     String?
  fechaCeremonia    DateTime?
  mensaje           String?
  estado            EstadoCotizacion       @default(NUEVA)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([estado])
  @@map("cotizaciones")
}
